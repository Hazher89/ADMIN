  ];

  const loadTemplate = (template: any) => {
    if (editor) {
      editor.setComponents(template.content);
      editor.setStyle('');
      setShowTemplates(false);
    }
  };

  // Undo/Redo functions
  const undo = () => {
    if (editor) {
      editor.UndoManager.undo();
    }
  };

  const redo = () => {
    if (editor) {
      editor.UndoManager.redo();
    }
  };

  const clearCanvas = () => {
    if (editor) {
      editor.setComponents('');
      editor.setStyle('');
    }
  };

  const duplicateComponent = () => {
    if (editor) {
      const selected = editor.getSelected();
      if (selected) {
        const component = selected.clone();
        editor.addComponent(component);
      }
    }
  };

  const deleteComponent = () => {
    if (editor) {
      const selected = editor.getSelected();
      if (selected) {
        selected.remove();
      }
    }
  };

  const copyComponent = () => {
    if (editor) {
      const selected = editor.getSelected();
      if (selected) {
        editor.StorageManager.store('clipboard', selected.toJSON());
      }
    }
  };

  const pasteComponent = () => {
    if (editor) {
      const clipboard = editor.StorageManager.load('clipboard');
      if (clipboard) {
        const component = editor.addComponent(clipboard);
        editor.select(component);
      }
    }
  };

  const selectAll = () => {
    if (editor) {
      editor.selectAll();
    }
  };

  const deselectAll = () => {
    if (editor) {
      editor.select(null);
    }
  };

  const zoomIn = () => {
    if (editor) {
      const canvas = editor.Canvas;
      const currentZoom = canvas.getZoom();
      canvas.setZoom(currentZoom + 0.1);
    }
  };

  const zoomOut = () => {
    if (editor) {
      const canvas = editor.Canvas;
      const currentZoom = canvas.getZoom();
      canvas.setZoom(currentZoom - 0.1);
    }
  };

  const resetZoom = () => {
    if (editor) {
      editor.Canvas.setZoom(1);
    }
  };

  const toggleFullscreen = () => {
    if (editor) {
      const canvas = editor.Canvas;
      canvas.toggleFullscreen();
    }
  };

  const previewMode = () => {
    if (editor) {
      editor.runCommand('preview');
    }
  };

  const editMode = () => {
    if (editor) {
      editor.stopCommand('preview');
    }
  };

  const exportHTML = () => {
    if (editor) {
      const html = editor.getHtml();
      const css = editor.getCss();
      const js = editor.getJs();
      
      const fullHTML = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exported Page</title>
    <style>${css}</style>
</head>
<body>
    ${html}
    <script>${js}</script>
</body>
</html>`;
      
      const blob = new Blob([fullHTML], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'exported-page.html';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const exportCSS = () => {
    if (editor) {
      const css = editor.getCss();
      const blob = new Blob([css], { type: 'text/css' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'styles.css';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const exportJS = () => {
    if (editor) {
      const js = editor.getJs();
      const blob = new Blob([js], { type: 'text/javascript' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'scripts.js';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const exportJSON = () => {
    if (editor) {
      const data = {
        html: editor.getHtml(),
        css: editor.getCss(),
        js: editor.getJs(),
        components: editor.getComponents(),
        styles: editor.getStyle(),
        timestamp: new Date().toISOString(),
        version: '1.0'
      };
      
      const json = JSON.stringify(data, null, 2);
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'project.json';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const importJSON = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = (e: any) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e: any) => {
          try {
            const data = JSON.parse(e.target.result);
            if (editor) {
              editor.setComponents(data.components || data.html || '');
              editor.setStyle(data.styles || data.css || '');
              if (data.js) {
                editor.setJs(data.js);
              }
            }
          } catch (error) {
            console.error('Error importing JSON:', error);
            alert('Error importing file. Please check the file format.');
          }
        };
        reader.readAsText(file);
      }
    };
    input.click();
  };

  const exportZip = () => {
    if (editor) {
      // This would require a zip library like JSZip
      // For now, we'll export individual files
      const html = editor.getHtml();
      const css = editor.getCss();
      const js = editor.getJs();
      
      const files = [
        { name: 'index.html', content: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exported Page</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    ${html}
    <script src="scripts.js"></script>
</body>
</html>` },
        { name: 'styles.css', content: css },
        { name: 'scripts.js', content: js }
      ];
      
      files.forEach(file => {
        const blob = new Blob([file.content], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = file.name;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  };

  // Preview functions
  const togglePreview = () => {
    setShowPreview(!showPreview);
    if (editor) {
      if (!showPreview) {
        editor.runCommand('preview');
      } else {
        editor.stopCommand('preview');
      }
    }
  };

  const setPreviewDevice = (device: 'desktop' | 'tablet' | 'mobile') => {
    setPreviewMode(device);
    if (editor) {
      const deviceManager = editor.DeviceManager;
      const devices = deviceManager.getAll();
      const targetDevice = devices.find((d: any) => d.getName().toLowerCase() === device);
      if (targetDevice) {
        deviceManager.select(targetDevice.getId());
      }
    }
  };

  const toggleResponsiveTools = () => {
    setShowResponsiveTools(!showResponsiveTools);
  };

  const addCustomDevice = () => {
    const name = prompt('Device name:');
    const width = prompt('Width (px):');
    const height = prompt('Height (px):');
    
    if (name && width && height && editor) {
      const deviceManager = editor.DeviceManager;
      deviceManager.add(name, width, height);
      console.log(`Added custom device: ${name} (${width}x${height})`);
    }
  };

  const generateResponsiveCSS = () => {
    if (editor) {
      const css = editor.getCss();
      const responsiveCSS = `
/* Responsive CSS Generated by DriftPro WYSIWYG */

/* Mobile First Approach */
@media (max-width: 480px) {
  /* Mobile styles */
  .container { padding: 10px; }
  .text-lg { font-size: 16px; }
  .text-xl { font-size: 18px; }
  .text-2xl { font-size: 20px; }
  .grid-cols-2 { grid-template-columns: 1fr; }
  .grid-cols-3 { grid-template-columns: 1fr; }
  .grid-cols-4 { grid-template-columns: 1fr; }
}

/* Tablet */
@media (min-width: 481px) and (max-width: 768px) {
  .grid-cols-3 { grid-template-columns: repeat(2, 1fr); }
  .grid-cols-4 { grid-template-columns: repeat(2, 1fr); }
}

/* Desktop */
@media (min-width: 769px) {
  /* Desktop styles */
}

/* Large Desktop */
@media (min-width: 1440px) {
  .container { max-width: 1200px; margin: 0 auto; }
}

${css}
      `;
      
      const blob = new Blob([responsiveCSS], { type: 'text/css' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'responsive-styles.css';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const saveDesign = () => {
    if (editor) {
      const data = {
        html: editor.getHtml(),
        css: editor.getCss(),
        js: editor.getJs(),
        components: editor.getComponents(),
        styles: editor.getStyle(),
        timestamp: new Date().toISOString()
      };
      
      localStorage.setItem('wysiwyg-design', JSON.stringify(data));
      alert('Design saved successfully!');
    }
  };

  const loadDesign = () => {
    const saved = localStorage.getItem('wysiwyg-design');
    if (saved && editor) {
      try {
        const data = JSON.parse(saved);
        editor.setComponents(data.components || data.html || '');
        editor.setStyle(data.styles || data.css || '');
        if (data.js) {
          editor.setJs(data.js);
        }
        alert('Design loaded successfully!');
      } catch (error) {
        console.error('Error loading design:', error);
        alert('Error loading saved design.');
      }
    } else {
      alert('No saved design found.');
    }
  };

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (!editor) return;
      
      const isCtrlOrCmd = e.ctrlKey || e.metaKey;
      
      if (isCtrlOrCmd) {
        switch (e.key) {
          case 'z':
            e.preventDefault();
            if (e.shiftKey) {
              redo();
            } else {
              undo();
            }
            break;
          case 'y':
            e.preventDefault();
            redo();
            break;
          case 'c':
            e.preventDefault();
            copyComponent();
            break;
          case 'v':
            e.preventDefault();
            pasteComponent();
            break;
          case 'a':
            e.preventDefault();
            selectAll();
            break;
          case 's':
            e.preventDefault();
            saveDesign();
            break;
          case 'd':
            e.preventDefault();
            duplicateComponent();
            break;
          case 'Delete':
          case 'Backspace':
            e.preventDefault();
            deleteComponent();
            break;
          case '=':
          case '+':
            e.preventDefault();
            zoomIn();
            break;
          case '-':
            e.preventDefault();
            zoomOut();
            break;
          case '0':
            e.preventDefault();
            resetZoom();
            break;
          case 'f':
            e.preventDefault();
            toggleFullscreen();
            break;
          case 'p':
            e.preventDefault();
            previewMode();
            break;
          case 'e':
            e.preventDefault();
            editMode();
            break;
        }
      } else {
        switch (e.key) {
          case 'Escape':
            deselectAll();
            break;
          case 'F11':
            e.preventDefault();
            toggleFullscreen();
            break;
        }
      }
    };

    document.addEventListener('keydown', handleKeyDown);
    return () => document.removeEventListener('keydown', handleKeyDown);
  }, [editor]);

  useEffect(() => {
    if (typeof window !== 'undefined' && editorRef.current && !editor) {
      import('grapesjs').then((grapesjs) => {
