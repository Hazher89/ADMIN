                defaults: 'none',
                list: [
                  { value: 'none', title: 'None' },
                  { value: 'left', title: 'Left' },
                  { value: 'right', title: 'Right' }
                ]
              },
              {
                name: 'Clear',
                property: 'clear',
                type: 'radio',
                defaults: 'none',
                list: [
                  { value: 'none', title: 'None' },
                  { value: 'left', title: 'Left' },
                  { value: 'right', title: 'Right' },
                  { value: 'both', title: 'Both' }
                ]
              }
            ],
          },
          {
            name: 'Transform',
            open: false,
            buildProps: [
              {
                name: 'Transform',
                property: 'transform',
                type: 'text',
                defaults: '',
                placeholder: 'e.g., rotate(45deg) scale(1.2)'
              },
              {
                name: 'Transform Origin',
                property: 'transform-origin',
                type: 'text',
                defaults: 'center center',
                placeholder: 'e.g., top left, 50% 50%'
              },
              {
                name: 'Transition',
                property: 'transition',
                type: 'text',
                defaults: '',
                placeholder: 'e.g., all 0.3s ease'
              },
              {
                name: 'Animation',
                property: 'animation',
                type: 'text',
                defaults: '',
                placeholder: 'e.g., slideIn 1s ease-in-out'
              }
            ],
          },
          {
            name: 'Filter',
            open: false,
            buildProps: [
              {
                name: 'Filter',
                property: 'filter',
                type: 'text',
                defaults: '',
                placeholder: 'e.g., blur(5px) brightness(1.2)'
              },
              {
                name: 'Backdrop Filter',
                property: 'backdrop-filter',
                type: 'text',
                defaults: '',
                placeholder: 'e.g., blur(10px)'
              }
            ],
          },
          {
            name: 'Custom Properties',
            open: false,
            buildProps: [
              {
                name: 'Custom CSS',
                property: 'custom-css',
                type: 'textarea',
                defaults: '',
              },
            ],
          }
        ],
        ],
      },
          deviceManager: {
            devices: [
              {
                name: 'Desktop',
                width: '',
                widthMedia: '1024px',
                priority: 1
              },
              {
                name: 'Tablet',
                width: '768px',
                widthMedia: '768px',
                priority: 2
              },
              {
                name: 'Mobile',
                width: '320px',
                widthMedia: '480px',
                priority: 3
              },
              {
                name: 'Large Desktop',
                width: '1440px',
                widthMedia: '1440px',
                priority: 0
              },
              {
                name: 'Small Mobile',
                width: '280px',
                widthMedia: '320px',
                priority: 4
              }
            ],
            defaultDevice: 'Desktop',
            customDevices: [
              {
                name: 'iPhone 12',
                width: '390px',
                height: '844px',
                priority: 5
              },
              {
                name: 'iPad Pro',
                width: '1024px',
                height: '1366px',
                priority: 6
              },
              {
                name: 'Samsung Galaxy',
                width: '360px',
                height: '640px',
                priority: 7
              }
            ]
          },
        });

        // Add custom commands
        editorInstance.Commands.add('set-device-desktop', {
          run: (editor: any) => editor.setDevice('Desktop')
        });
        editorInstance.Commands.add('set-device-tablet', {
          run: (editor: any) => editor.setDevice('Tablet')
        });
        editorInstance.Commands.add('set-device-mobile', {
          run: (editor: any) => editor.setDevice('Mobile')
        });

        setEditor(editorInstance);
      });
    }
  }, [editor]);

  const saveDesign = () => {
    if (editor) {
      const html = editor.getHtml();
      const css = editor.getCss();
      const js = editor.getJs();
      
      localStorage.setItem(`wysiwyg-page-${currentPage}`, JSON.stringify({ html, css, js }));
      alert('Design saved successfully!');
    }
  };

  const exportCode = () => {
    if (editor) {
      const html = editor.getHtml();
      const css = editor.getCss();
      const js = editor.getJs();
      
      const fullCode = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exported Design</title>
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <style>${css}</style>
</head>
<body>
  ${html}
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>${js}</script>
</body>
</html>`;
      
      const blob = new Blob([fullCode], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `page-${currentPage}.html`;
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const loadDesign = () => {
    if (editor) {
      const savedDesign = localStorage.getItem(`wysiwyg-page-${currentPage}`);
      if (savedDesign) {
        const { html, css, js } = JSON.parse(savedDesign);
        editor.setComponents(html);
        editor.setStyle(css);
        alert('Design loaded successfully!');
      } else {
        alert('No saved design found for this page.');
      }
    }
  };

  const addNewPage = () => {
    const newPageId = Date.now().toString();
    const newPageName = prompt('Enter page name:');
    if (newPageName) {
      setPages([...pages, { id: newPageId, name: newPageName }]);
      setCurrentPage(newPageId);
    }
  };

  const clearCanvas = () => {
    if (editor && confirm('Are you sure you want to clear the canvas?')) {
      editor.setComponents('');
      editor.setStyle('');
    }
  };

  const undo = () => {
    if (editor) {
      editor.UndoManager.undo();
    }
  };

  const redo = () => {
    if (editor) {
      editor.UndoManager.redo();
    }
  };

  const duplicateComponent = () => {
    if (editor) {
      const selected = editor.getSelected();
      if (selected) {
        const component = selected.clone();
        selected.parent().append(component);
      }
    }
  };

  const exportJSON = () => {
    if (editor) {
      const data = {
        html: editor.getHtml(),
        css: editor.getCss(),
        js: editor.getJs(),
        components: editor.getComponents(),
        styles: editor.getStyle(),
        timestamp: new Date().toISOString(),
        version: '1.0'
      };
      
      const json = JSON.stringify(data, null, 2);
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'project.json';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const importJSON = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = (e: any) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e: any) => {
          try {
            const data = JSON.parse(e.target.result);
            if (editor) {
              editor.setComponents(data.components || data.html || '');
              editor.setStyle(data.styles || data.css || '');
              if (data.js) {
                editor.setJs(data.js);
              }
            }
          } catch (error) {
            console.error('Error importing JSON:', error);
            alert('Error importing file. Please check the file format.');
          }
        };
        reader.readAsText(file);
      }
    };
    input.click();
  };

  const exportZip = () => {
    if (editor) {
      const html = editor.getHtml();
      const css = editor.getCss();
      const js = editor.getJs();
      
      const files = [
        { name: 'index.html', content: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exported Page</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    ${html}
    <script src="scripts.js"></script>
</body>
</html>` },
        { name: 'styles.css', content: css },
        { name: 'scripts.js', content: js }
      ];
      
      files.forEach(file => {
        const blob = new Blob([file.content], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = file.name;
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  };

  // Preview functions
  const togglePreview = () => {
    setShowPreview(!showPreview);
    if (editor) {
      if (!showPreview) {
        editor.runCommand('preview');
      } else {
        editor.stopCommand('preview');
      }
    }
  };

  const setPreviewDevice = (device: 'desktop' | 'tablet' | 'mobile') => {
    setPreviewMode(device);
    if (editor) {
      const deviceManager = editor.DeviceManager;
      const devices = deviceManager.getAll();
      const targetDevice = devices.find((d: any) => d.getName().toLowerCase() === device);
      if (targetDevice) {
        deviceManager.select(targetDevice.getId());
      }
    }
  };

  const toggleResponsiveTools = () => {
    setShowResponsiveTools(!showResponsiveTools);
  };

  const addCustomDevice = () => {
    const name = prompt('Device name:');
    const width = prompt('Width (px):');
    const height = prompt('Height (px):');
    
    if (name && width && height && editor) {
      const deviceManager = editor.DeviceManager;
      deviceManager.add(name, width, height);
      console.log(`Added custom device: ${name} (${width}x${height})`);
    }
  };

  const generateResponsiveCSS = () => {
    if (editor) {
      const css = editor.getCss();
      const responsiveCSS = `
/* Responsive CSS Generated by DriftPro WYSIWYG */

/* Mobile First Approach */
@media (max-width: 480px) {
  /* Mobile styles */
  .container { padding: 10px; }
  .text-lg { font-size: 16px; }
  .text-xl { font-size: 18px; }
  .text-2xl { font-size: 20px; }
  .grid-cols-2 { grid-template-columns: 1fr; }
  .grid-cols-3 { grid-template-columns: 1fr; }
  .grid-cols-4 { grid-template-columns: 1fr; }
}

/* Tablet */
@media (min-width: 481px) and (max-width: 768px) {
  .grid-cols-3 { grid-template-columns: repeat(2, 1fr); }
  .grid-cols-4 { grid-template-columns: repeat(2, 1fr); }
}

/* Desktop */
@media (min-width: 769px) {
  /* Desktop styles */
}

/* Large Desktop */
@media (min-width: 1440px) {
  .container { max-width: 1200px; margin: 0 auto; }
}

${css}
      `;
      
      const blob = new Blob([responsiveCSS], { type: 'text/css' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'responsive-styles.css';
      a.click();
      URL.revokeObjectURL(url);
    }
  };

  const loadTemplate = (template: any) => {
    if (editor) {
      editor.setComponents(template.content);
      setShowTemplates(false);
    }
  };

  return (
    <div>
      {/* Page Header */}
      <div className="page-header">
        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', marginBottom: '1rem' }}>
          <div className="card-icon">
            <Palette />
          </div>
          <div>
            <h1 className="page-title">🎨 WYSIWYG Editor</h1>
            <p className="page-subtitle">
              Rediger hele websiden visuelt - fra små detaljer til store endringer
            </p>
          </div>
        </div>
        
        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap' }}>
          <span className="badge badge-primary">
            {pages.length} sider
          </span>
          <span className="badge badge-secondary">
            Live redigering
          </span>
          
          {/* Action Buttons */}
          <button
            onClick={saveDesign}
            className="btn btn-success"
            title="Lagre Design"
          >
            <Save size={16} />
            Lagre
          </button>
          
          <button
            onClick={loadDesign}
            className="btn btn-primary"
            title="Last inn Design"
          >
            <Upload size={16} />
            Last inn
          </button>
          
          <button
            onClick={() => setShowTemplates(true)}
            className="btn btn-warning"
            title="Last inn Template"
          >
            <FileText size={16} />
            Templates
          </button>
          
          <button
            onClick={undo}
            className="btn btn-secondary"
            title="Angre (Ctrl+Z)"
          >
            <Undo size={16} />
            Angre
          </button>
          
          <button
            onClick={redo}
            className="btn btn-secondary"
            title="Gjør om (Ctrl+Y)"
          >
            <Redo size={16} />
            Gjør om
          </button>
          
          <button
            onClick={duplicateComponent}
            className="btn btn-secondary"
            title="Dupliser (Ctrl+D)"
          >
            <Copy size={16} />
            Dupliser
          </button>
          
          <button
            onClick={clearCanvas}
            className="btn btn-danger"
            title="Tøm Canvas"
          >
            <Trash2 size={16} />
            Tøm
          </button>
          
          <button
            onClick={exportCode}
            className="btn btn-secondary"
            title="Eksporter HTML"
          >
            <Download size={16} />
            Eksporter
          </button>
          
          <button
            onClick={exportJSON}
            className="btn btn-secondary"
            title="Eksporter JSON"
          >
            <FileText size={16} />
            JSON
          </button>
          
          <button
            onClick={importJSON}
            className="btn btn-secondary"
            title="Importer JSON"
          >
            <Upload size={16} />
            Importer
          </button>
          
          <button
            onClick={exportZip}
            className="btn btn-secondary"
            title="Eksporter som ZIP"
          >
            <Download size={16} />
            ZIP
          </button>
          
          <button
            onClick={togglePreview}
            className={`btn ${showPreview ? 'btn-success' : 'btn-secondary'}`}
            title="Preview Mode"
          >
            <Eye size={16} />
            Preview
          </button>
          
          <button
            onClick={toggleResponsiveTools}
            className={`btn ${showResponsiveTools ? 'btn-primary' : 'btn-secondary'}`}
            title="Responsive Design Tools"
          >
            <Monitor size={16} />
            Responsive
          </button>
          
          <button
            onClick={addNewPage}
            className="btn btn-warning"
            title="Legg til ny side"
          >
            <Plus size={16} />
            Ny Side
          </button>
          
          <div className="panel__devices flex items-center space-x-1"></div>
          <div className="panel__basic-actions flex items-center space-x-1"></div>
        </div>
      </div>

      {/* Pages Navigation */}
      <div className="card" style={{ marginBottom: '2rem' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', flexWrap: 'wrap' }}>
          <span style={{ fontWeight: '500', color: '#374151' }}>Aktive sider:</span>
          {pages.map((page) => (
            <button
              key={page.id}
              onClick={() => setCurrentPage(page.id)}
              className={`btn ${currentPage === page.id ? 'btn-primary' : 'btn-secondary'}`}
              style={{ fontSize: 'var(--font-size-sm)' }}
            >
              {page.name}
            </button>
          ))}
        </div>
      </div>

      {/* Main Editor Area */}
      <div style={{ display: 'flex', gap: '2rem', height: 'calc(100vh - 300px)' }}>
        {/* Left Sidebar - Blocks */}
        <div className="card" style={{ width: '280px', minWidth: '280px' }}>
          <div className="card-header">
            <div className="card-icon">
              <Grid size={20} />
            </div>
            <div>
              <h3 className="card-title">Komponenter</h3>
              <p className="card-description">Dra og slipp elementer</p>
            </div>
          </div>
          <div className="card-content" style={{ padding: '1rem' }}>
            <div className="blocks-container"></div>
          </div>
        </div>

        {/* Center - Canvas */}
        <div style={{ flex: '1', display: 'flex', flexDirection: 'column' }}>
          <div className="card" style={{ flex: '1', padding: '0' }}>
            <div className="card-header">
              <div className="card-icon">
                <Palette size={20} />
              </div>
              <div>
                <h3 className="card-title">Canvas</h3>
                <p className="card-description">Rediger nettsiden</p>
              </div>
            </div>
            <div className="card-content" style={{ padding: '1rem', height: 'calc(100% - 80px)' }}>
              <div 
                ref={editorRef} 
                id="gjs"
                style={{ 
                  height: '100%',
                  width: '100%',
                  border: '1px solid #e5e7eb',
                  borderRadius: '8px',
                  overflow: 'hidden',
                  backgroundColor: '#ffffff'
                }}
              />
            </div>
          </div>
        </div>

        {/* Right Sidebar - Layers, Styles, Traits */}
        <div className="card" style={{ width: '300px', minWidth: '300px' }}>
          <div className="card-header">
            <div className="card-icon">
              <Settings size={20} />
            </div>
            <div>
              <h3 className="card-title">Egenskaper</h3>
              <p className="card-description">Rediger elementer</p>
            </div>
          </div>
          <div className="card-content" style={{ padding: '1rem' }}>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>
              {/* Layers */}
              <div>
                <h4 style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem', fontSize: '14px', fontWeight: '600', color: '#374151' }}>
                  <Layers size={16} />
                  Lag
                </h4>
                <div className="layers-container" style={{ 
                  backgroundColor: '#f9fafb', 
                  borderRadius: '6px', 
                  padding: '0.75rem',
                  border: '1px solid #e5e7eb',
                  minHeight: '120px'
                }}></div>
              </div>

              {/* Style Manager */}
              <div>
                <h4 style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem', fontSize: '14px', fontWeight: '600', color: '#374151' }}>
                  <Palette size={16} />
                  Stiler
                </h4>
                <div className="styles-container" style={{ 
                  backgroundColor: '#f9fafb', 
                  borderRadius: '6px', 
                  padding: '0.75rem',
                  border: '1px solid #e5e7eb',
                  minHeight: '200px'
                }}></div>
              </div>

              {/* Trait Manager */}
              <div>
                <h4 style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem', fontSize: '14px', fontWeight: '600', color: '#374151' }}>
                  <Settings size={16} />
                  Innstillinger
                </h4>
                <div className="traits-container" style={{ 
                  backgroundColor: '#f9fafb', 
                  borderRadius: '6px', 
                  padding: '0.75rem',
                  border: '1px solid #e5e7eb',
                  minHeight: '150px'
                }}></div>
              </div>

              {/* Selector Manager */}
              <div>
                <h4 style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem', fontSize: '14px', fontWeight: '600', color: '#374151' }}>
                  <Type size={16} />
                  Selektorer
                </h4>
                <div className="selectors-container" style={{ 
                  backgroundColor: '#f9fafb', 
                  borderRadius: '6px', 
                  padding: '0.75rem',
                  border: '1px solid #e5e7eb',
                  minHeight: '100px'
                }}></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Template Modal */}
      {showTemplates && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden">
            <div className="flex items-center justify-between p-6 border-b border-gray-200">
              <h2 className="text-2xl font-semibold text-gray-900">Choose a Template</h2>
              <button 
                onClick={() => setShowTemplates(false)} 
                className="p-2 rounded-lg hover:bg-gray-100"
              >
                <X size={24} />
              </button>
            </div>
            <div className="p-6 overflow-y-auto max-h-[calc(90vh-120px)]">
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {templates.map((template) => (
                  <div key={template.id} className="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                    <img 
                      src={template.thumbnail} 
                      alt={template.name}
                      className="w-full h-48 object-cover"
                    />
                    <div className="p-4">
                      <h3 className="text-lg font-semibold text-gray-900 mb-2">{template.name}</h3>
                      <p className="text-gray-600 text-sm mb-4">{template.description}</p>
                      <button
                        onClick={() => loadTemplate(template)}
                        className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200"
                      >
                        Use Template
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Responsive Design Tools Panel */}
      {showResponsiveTools && (
        <div className="fixed top-20 right-4 bg-white rounded-xl shadow-2xl border border-gray-200 z-40 w-80">
          <div className="p-4 border-b border-gray-200">
            <div className="flex items-center justify-between">
              <h3 className="text-lg font-semibold text-gray-900">Responsive Tools</h3>
              <button onClick={() => setShowResponsiveTools(false)} className="p-1 rounded hover:bg-gray-100">
                <X className="w-4 h-4" />
              </button>
            </div>
          </div>
          <div className="p-4 space-y-4">
            {/* Device Selection */}
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">Device Preview</label>
              <div className="grid grid-cols-3 gap-2">
                <button
                  onClick={() => setPreviewDevice('desktop')}
                  className={`px-3 py-2 rounded text-sm font-medium transition-colors ${
                    previewMode === 'desktop' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                  }`}
                >
                  Desktop
                </button>
                <button
                  onClick={() => setPreviewDevice('tablet')}
                  className={`px-3 py-2 rounded text-sm font-medium transition-colors ${
                    previewMode === 'tablet' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                  }`}
                >
                  Tablet
                </button>
                <button
                  onClick={() => setPreviewDevice('mobile')}
                  className={`px-3 py-2 rounded text-sm font-medium transition-colors ${
                    previewMode === 'mobile' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                  }`}
                >
                  Mobile
                </button>
              </div>
            </div>

            {/* Custom Device */}
            <div>
              <button
                onClick={addCustomDevice}
                className="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition-colors flex items-center justify-center space-x-2"
              >
                <Plus className="w-4 h-4" />
                <span>Legg til Custom Device</span>
              </button>
            </div>

            {/* Responsive CSS Generator */}
            <div>
              <button
                onClick={generateResponsiveCSS}
                className="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded-lg transition-colors flex items-center justify-center space-x-2"
              >
                <Code className="w-4 h-4" />
                <span>Generer Responsive CSS</span>
              </button>
            </div>

            {/* Breakpoint Info */}
            <div className="bg-gray-50 rounded-lg p-3">
              <h4 className="font-medium text-gray-900 mb-2">Breakpoints</h4>
              <div className="text-sm text-gray-600 space-y-1">
                <div>• Mobile: &lt; 480px</div>
                <div>• Tablet: 481px - 768px</div>
                <div>• Desktop: 769px - 1440px</div>
                <div>• Large: &gt; 1440px</div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Preview Modal */}
      {showPreview && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden">
            <div className="flex items-center justify-between p-6 border-b border-gray-200">
              <h2 className="text-xl font-semibold text-gray-900">Preview Mode</h2>
              <div className="flex items-center space-x-4">
                <div className="flex items-center space-x-2">
                  <span className="text-sm text-gray-600">Device:</span>
                  <select
                    value={previewMode}
                    onChange={(e) => setPreviewDevice(e.target.value as 'desktop' | 'tablet' | 'mobile')}
                    className="px-3 py-1 border border-gray-300 rounded text-sm"
                  >
                    <option value="desktop">Desktop</option>
                    <option value="tablet">Tablet</option>
                    <option value="mobile">Mobile</option>
                  </select>
                </div>
                <button onClick={() => setShowPreview(false)} className="p-2 rounded-lg hover:bg-gray-100">
                  <X className="w-4 h-4" />
                </button>
              </div>
            </div>
            <div className="p-6 overflow-y-auto max-h-[calc(90vh-120px)]">
              <div className={`mx-auto ${previewMode === 'mobile' ? 'max-w-sm' : previewMode === 'tablet' ? 'max-w-2xl' : 'max-w-full'}`}>
                <div 
                  className="border border-gray-300 rounded-lg overflow-hidden"
                  style={{
                    width: previewMode === 'mobile' ? '375px' : previewMode === 'tablet' ? '768px' : '100%',
                    height: previewMode === 'mobile' ? '667px' : previewMode === 'tablet' ? '1024px' : 'auto',
                    minHeight: previewMode === 'desktop' ? '600px' : 'auto'
                  }}
                >
                  {editor && (
                    <div 
                      dangerouslySetInnerHTML={{ 
                        __html: editor.getHtml() + '<style>' + editor.getCss() + '</style>' 
                      }}
                    />
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
